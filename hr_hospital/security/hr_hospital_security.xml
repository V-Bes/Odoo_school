<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="hr_hospital_rule_patient" model="ir.rule">
            <field name="name">Hr hospital users can only view own visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('hr_hospital_patient_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_hospital_patient'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_hospital_visit_rule_intern" model="ir.rule">
                <field name="name">Hr hospital users can only view/edit own visits</field>
                <field name="model_id" ref="model_hr_hospital_visit"/>
                <field name="domain_force">[('hr_hospital_doctor_id.user_id', '=', user.id)]</field>
                <field name="groups" eval="[(4, ref('group_hr_hospital_intern'))]"/>
                <field name="perm_read" eval="True"/>
                <field name="perm_write" eval="False"/>
                <field name="perm_create" eval="False"/>
                <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_hospital_visit_rule_doctor" model="ir.rule">
            <field name="name">Hr hospital users can only view/edit own visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[('hr_hospital_doctor_id.mentor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_hospital_doctor1'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_hospital_visit_rule_manager" model="ir.rule">
            <field name="name">Hr hospital users can only view all visits</field>
            <field name="model_id" ref="model_hr_hospital_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_hospital_manager1'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="hr_hospital_rule_admin" model="ir.rule">
            <field name="name">Hr hospital administrators have full rights on visits</field>
            <field name="model_id" ref="hr_hospital.model_hr_hospital_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_hospital_admin'))]"/>
        </record>
</odoo>
