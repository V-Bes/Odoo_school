<?xml version="1.0" encoding="utf-8"?>
<odoo>


        <record id="category_hr_hospital" model="ir.module.category">
            <field name="name">Hr hospital</field>
            <field name="description">User access levels for the hr_hospital</field>
            <field name="sequence">1</field>
        </record>

        <record id="group_hr_hospital_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="comment">Patients of the hr_hospital</field>
        </record>

        <record id="group_hr_hospital_intern" model="res.groups">
            <field name="name">Intern</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="comment">Interns of the hr_hospital</field>
        </record>

        <record id="group_hr_hospital_doctor1" model="res.groups">
            <field name="name">Doctor</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_intern'))]"/>
            <field name="comment">Doctors of the hr_hospital</field>
        </record>

        <record id="group_hr_hospital_manager1" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_patient'))]"/>
            <field name="comment">Managers of the hr_hospital</field>
        </record>

        <record id="group_hr_hospital_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_manager1'))]"/>

            <field name="comment">Administrators of the hr_hospital (full rights)</field>
        </record>

</odoo>
